# Modified for Lumi Agents (https://github.com/RunLumi/LumiAgents) from ZCode (https://github.com/zai-org/ZCode). Apache-2.0 §4(b) modification notice.
# Lumi Agents does not treat upstream ZCode product infrastructure as Lumi infrastructure.
# Product-service compatibility endpoints are intentionally unset here. Configure them only
# when you have the right/authorization to use the corresponding upstream service.
ZCODE_BASE_URL=
ZAI_OAUTH_ORIGIN=
ZAI_OAUTH_CLIENT_ID=
ZCODE_CDN_BASE_URL=
ZCODE_CONVERSATION_SHARE_WEB_URL=
ZCODE_REMOTE_ASSET_CDN_BASE_URL=

# Optional model-provider endpoints. These identify providers, not Lumi-owned services.
BIGMODEL_API_BASE_URL=https://bigmodel.cn
ZAI_BUSINESS_BASE_URL=https://api.z.ai

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=

# App Store Connect API upload credentials. Keep the .p8 private key outside Git.
APPLE_API_KEY=AuthKey_3XJ664VDDN.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Mac App Store signing material; provide these only in a protected local/CI env.
MAS_APP_SIGNING_IDENTITY=
MAS_INSTALLER_IDENTITY=
MAS_PROVISIONING_PROFILE=
